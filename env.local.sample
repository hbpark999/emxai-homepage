# 교육 게시판(Notion 연동) 환경변수
#
# 사용법: 이 파일을 복사해 ".env.local" 이름으로 저장한 뒤 실제 값을 채우세요.
#        .env.local 은 .gitignore 에 포함되어 Git 에 올라가지 않습니다.
#        Vercel 에 배포할 때는 Settings > Environment Variables 에 같은 값을 등록합니다.

# Notion 내부 통합 시크릿 (설정 > 연결 > 직접 연결 개발하기 에서 발급, ntn_ 로 시작)
NOTION_TOKEN=

# 게시판 데이터베이스 ID (데이터베이스 주소에서 ?v= 앞의 32자리)
NOTION_BOARD_DB_ID=
