# 교육 게시판(Notion 연동) 환경변수
#
# 사용법: 이 파일을 복사해 ".env.local" 이름으로 저장한 뒤 실제 값을 채우세요.
#        .env.local 은 .gitignore 에 포함되어 Git 에 올라가지 않습니다.
#        Vercel 에 배포할 때는 Settings > Environment Variables 에 같은 값을 등록합니다.

# Notion 내부 통합 시크릿 (설정 > 연결 > 직접 연결 개발하기 에서 발급, ntn_ 로 시작)
NOTION_TOKEN=

# 게시판 데이터베이스 ID (데이터베이스 주소에서 ?v= 앞의 32자리)
NOTION_BOARD_DB_ID=

# 교육 문의/제안서 요청 데이터베이스 ID
NOTION_EDUCATION_INQUIRY_DB_ID=

# 교육생 전용 코너 과정별 비밀번호
EDU_PASS_RAPA_AI_EM_ANALYSIS_SIM_DAY3=
EDU_PASS_RAPA_DRC_AI_PCB_DAY3=
EDU_PASS_RAPA_EMC_GENAI=
EDU_PASS_RAPA_EMI_SI_GENAI_DAY2=
EDU_PASS_RAPA_EM_ANALYSIS_DESIGN_DAY2=
EDU_PASS_TTA_POWER_NOISE_DAY2=
EDU_PASS_UNIV_STUDENT_EM_DESIGN_PRACTICE=

# 문의/제안서 요청 메일 알림(Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hbpark@emxai.net
CONTACT_FROM_EMAIL=EMxAI <no-reply@send.emxai.net>

# CE-CMF 일일 사용량: 기본 100회 + 이메일 인증 후 추가 100회
# Vercel Marketplace의 Upstash Redis 연결 시 제공되는 값을 사용합니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CMC_QUOTA_SECRET=

# 선택: Cloud Run이 동일 키를 검사하도록 설정하면 API 직접 호출을 차단할 수 있습니다.
CMC_INTERNAL_API_KEY=
